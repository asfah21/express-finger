# NODE_ENV=production (OPSIONAL, tidak wajib ubah Dockerfile):
#   - Error response menjadi generik (tidak membocorkan detail internal).
# Cookie sesi `secure` & HSTS TIDAK bergantung NODE_ENV — keduanya aktif
# otomatis HANYA saat request lewat HTTPS (termasuk via reverse proxy),
# sehingga akses LAN HTTP (mis. http://10.10.11.5:8080) tetap berfungsi penuh.
# NODE_ENV=production
PORT=8080
PGUSER=your_username
PGPASSWORD=your_password
PGHOST=127.0.0.1
PGDATABASE=your_database
PGPORT=5432
API_KEY=your_api_key
JWT_SECRET=your-strong-random-secret-key-min-32-chars
RAW_DIR=/tmp
MAX_LIMIT=1000

# Direktori upload file (Multer). Di luar public/ agar tidak dieksekusi browser.
# Kosong = app/data/uploads (relatif ke folder app).
# UPLOAD_DIR=/path/ke/data/uploads

# CORS: Daftar origin yang diizinkan untuk request cross-origin ber-credential
# (dipisah koma). Contoh: http://192.168.1.5:8080,http://kiosk.lan
# KOSONG (default) = same-origin saja; origin lain DITOLAK browser.
CORS_ORIGINS=

# IP perangkat ZK yang boleh push data ke /iclock (dipisah koma).
# KOSONG (default) = semua IP di LAN diizinkan (dengan rate limit tetap aktif).
# Isi untuk pembatasan ketat, mis. 192.168.1.10,192.168.1.11
ICLOCK_ALLOWED_IPS=

# IP reverse-proxy (nginx/Caddy) untuk app.set('trust proxy').
# KOSONG (default) = nonaktif (req.ip = IP socket; paling aman utk LAN langsung).
# Di belakang nginx/Caddy, isi hop count atau IP proxy AGAR rate-limit per-IP
# tetap akurat, mis. TRUST_PROXY=1 (satu hop) atau TRUST_PROXY=127.0.0.1.
# JANGAN set TRUST_PROXY=true (mempercayai semua proxy) — klien bisa memalsukan
# X-Forwarded-For untuk bypass rate-limit, dan express-rate-limit menolaknya.
TRUST_PROXY=

# ============================================================================
# RATE LIMITING (Hardening)
# Semua nilai di bawah memiliki default aman. Sesuaikan per lingkungan.
# Format: <nilai> per <jendela> per <kunci>. Kunci: IP, akun (username), atau
# perangkat (SN / x-device-id). Respon berlebih = HTTP 429 + header Retry-After.
# ============================================================================
#
# Global catch-all — max request per IP per menit (semua endpoint/static).
RATE_LIMIT_GLOBAL_MAX=600
# /auth non-login — max request per IP per menit.
RATE_LIMIT_AUTH_MAX=60
# Login — percobaan per akun (username) per 15 menit.
RATE_LIMIT_LOGIN_ACCOUNT_MAX=5
# Login — percobaan per IP per 15 menit (cegah password spraying lintas-akun).
RATE_LIMIT_LOGIN_IP_MAX=20
# Verify (autentikasi ulang settings) — percobaan per IP per 15 menit.
RATE_LIMIT_VERIFY_IP_MAX=10
# Verify — percobaan per akun per 15 menit.
RATE_LIMIT_VERIFY_ACCOUNT_MAX=5
# User management (buat/hapus/reset user, ubah role) — operasi per IP per 15 menit.
RATE_LIMIT_USER_MGMT_IP_MAX=20
# User management — operasi per akun per 15 menit.
RATE_LIMIT_USER_MGMT_ACCOUNT_MAX=10
# General API — max request per IP per menit.
RATE_LIMIT_API_MAX=100
# General API — max request per IP per jendela burst (mencegah scraping cepat).
RATE_LIMIT_API_BURST_MAX=30
# General API — panjang jendela burst dalam milidetik (default 10 detik).
RATE_LIMIT_API_BURST_WINDOW_MS=10000
# Sync/pull/template/biometrics — max request per IP per menit.
RATE_LIMIT_SYNC_MAX=10
# Sync/pull/template/biometrics — max request per perangkat target (sn/ip) per menit.
RATE_LIMIT_SYNC_DEVICE_MAX=5
# Activity log — max request per IP per menit (sesuai laju refresh dashboard).
RATE_LIMIT_ACTIVITY_LOG_MAX=30
# /iclock (protokol perangkat ZK) — max request per IP per menit.
RATE_LIMIT_ICLOCK_IP_MAX=90
# /iclock — max request per serial number (SN) per menit. Naikkan bila
# perangkat melaporkan gagal sinkron massal (mis. 240).
RATE_LIMIT_ICLOCK_DEVICE_MAX=120
# Kiosk live (absensi wajah) — max request per perangkat (x-device-id) per menit.
RATE_LIMIT_KIOSK_LIVE_DEVICE_MAX=30
# Kiosk live — max request per IP per menit.
RATE_LIMIT_KIOSK_LIVE_IP_MAX=60

# ============================================================================
# CSRF & lainnya
# ============================================================================
# Secret CSRF (opsional). Jika kosong, diturunkan dari JWT_SECRET.
# Set bila ingin secret terpisah dari JWT.
CSRF_SECRET=

# Set 'true' hanya bila seluruh trafik sudah HTTPS (cookie CSRF Secure).
CSRF_SECURE_COOKIE=false

# Live face-recognition service
# Local Node process: 127.0.0.1. Docker app talking to compose service: http://127.0.0.1:8090 with host networking.
FACE_SERVICE_URL=http://127.0.0.1:8090
FACE_SERVICE_TOKEN=change-this-internal-token
FACE_SERVICE_TIMEOUT_MS=15000
YOLO_CONF_THRESHOLD=0.40
FACE_SIM_THRESHOLD=0.35
FACE_DET_SIZE=640
PUBLIC_USERNAME=public
PUBLIC_USER_PASSWORD=public123

# Kiosk device lock — 'public' sessions are immortal (sliding renewal on every
# heartbeat) and bound to one approved device each (1 user = 1 device).
PUBLIC_SESSION_TTL_MS=31536000000
KIOSK_DEVICE_HEADER=x-device-id
