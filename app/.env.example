PORT=8080
PGUSER=your_username
PGPASSWORD=your_password
PGHOST=127.0.0.1
PGDATABASE=your_database
PGPORT=5432
API_KEY=your_api_key
JWT_SECRET=your-strong-random-secret-key-min-32-chars
RAW_DIR=/tmp
MAX_LIMIT=1000

# CORS: Daftar origin yang diizinkan (dipisah koma)
# Contoh: https://app.example.com,https://admin.example.com
# Jika tidak diset, semua origin diizinkan (development mode)
CORS_ORIGINS=
